<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Return Item</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <style>
        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background-color: #f8f9fa;
            color: #343a40;
        }

        .card {
            border-radius: 12px;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        }

        .item-summary {
            background-color: #f8f9fa;
            border-radius: 8px;
            padding: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-return {
            background-color: #28a745;
            color: white;
            border-radius: 30px;
            font-size: 1rem;
            padding: 10px 20px;
        }

        .btn-return:hover {
            background-color: #218838;
        }

        .btn-return:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

        .btn-back {
            background-color: #6c757d;
            color: white;
            border-radius: 30px;
            font-size: 1rem;
            padding: 10px 20px;
        }

        .btn-back:hover {
            background-color: #5a6268;
        }
    </style>
</head>

<body>

    <div class="container mt-5">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5>Return Item</h5>
            </div>
            <div class="card-body">
                <h6>Order Details</h6>
                <p><strong>Order ID:</strong> <%= order.orderId %></p>
                <p><strong>Order Date:</strong> <%= order.createdOn.toDateString() %></p>

                <hr>

                <h6>Item to Return</h6>
                <div class="item-summary mb-3">
                    <div>
                        <strong><%= item.product ? item.product.productName : item.productName %></strong>
                        <div class="text-muted">Quantity: <%= item.quantity %></div>
                    </div>
                    <div class="font-weight-bold">₹<%= item.price * item.quantity %></div>
                </div>

                <p class="text-muted">
                    This will submit a return request for this item only. It will stay pending
                    until an admin approves it.
                </p>

                <hr>

                <h6>Reason for Return</h6>
                <div class="form-group">
                    <input type="text" id="returnReason" class="form-control"
                        placeholder="Enter your reason for return" />
                </div>

                <div class="d-flex justify-content-between">
                    <a href="/order-details/<%= order._id %>" class="btn btn-back">Back to Order</a>
                    <button id="confirmReturnItem" class="btn btn-return"
                        data-order-id="<%= order._id %>" data-item-id="<%= item._id %>">
                        Confirm Return
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            $('#confirmReturnItem').on('click', function () {
                const $btn = $(this);
                const orderId = $btn.data('order-id');
                const itemId = $btn.data('item-id');
                const reason = $('#returnReason').val().trim();

                if (!reason) {
                    Swal.fire('Error', 'Please provide a reason for return.', 'error');
                    return;
                }

                Swal.fire({
                    title: 'Are you sure?',
                    text: 'You will not be able to undo this action!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, return it!',
                    cancelButtonText: 'No, keep it'
                }).then((result) => {
                    if (!result.isConfirmed) return;

                    $btn.prop('disabled', true).text('Submitting...');

                    $.ajax({
                        url: `/return-order-item/${orderId}/${itemId}`,
                        method: 'POST',
                        data: { reason },
                        success: function () {
                            Swal.fire('Submitted!', 'The return request has been recorded.', 'success')
                                .then(() => {
                                    window.location.href = `/order-details/${orderId}`;
                                });
                        },
                        error: function (xhr) {
                            const msg = xhr.responseJSON?.message || 'Something went wrong. Please try again.';
                            Swal.fire('Error!', msg, 'error');
                            $btn.prop('disabled', false).text('Confirm Return');
                        }
                    });
                });
            });
        });
    </script>

</body>

</html>
