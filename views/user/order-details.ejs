<!DOCTYPE html>
<html>

<head>
    <title>Order Details</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <style>
        :root {
            --primary-color: #2c3e50;
            --secondary-color: #34495e;
            --accent-color: #3498db;
            --success-color: #2ecc71;
            --warning-color: #f1c40f;
            --danger-color: #e74c3c;
            --muted-color: #95a5a6;
            --light-gray: #f8f9fa;
            --border-radius: 12px;
        }

        body {
            background-color: var(--light-gray);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            color: var(--secondary-color);
            line-height: 1.6;
        }

        .header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 1.5rem 0;
            margin-bottom: 2rem;
        }

        .order-card {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .order-header {
            border-bottom: 2px solid var(--light-gray);
            padding-bottom: 1rem;
            margin-bottom: 1.5rem;
        }

        .order-id {
            color: var(--primary-color);
            font-size: 1.25rem;
            font-weight: 600;
        }

        .badge-pill-group {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .payment-method,
        .status-badge {
            padding: 0.5rem 1rem;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 500;
            white-space: nowrap;
        }

        .payment-method {
            background-color: antiquewhite;
        }

        .badge-delivered,
        .badge-returned {
            background-color: var(--success-color);
            color: white;
        }

        .badge-pending,
        .badge-processing,
        .badge-return-request {
            background-color: var(--warning-color);
            color: var(--secondary-color);
        }

        .badge-cancelled {
            background-color: var(--danger-color);
            color: white;
        }

        .badge-active,
        .badge-shipped {
            background-color: var(--muted-color);
            color: white;
        }

        .order-items {
            background-color: var(--light-gray);
            border-radius: var(--border-radius);
            padding: 1.5rem;
            margin: 1.5rem 0;
        }

        .item-card {
            background: white;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1rem;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 0.75rem;
        }

        .item-details {
            flex-grow: 1;
            min-width: 200px;
        }

        .item-details .item-reason {
            font-size: 0.8rem;
            color: var(--muted-color);
            margin-top: 0.25rem;
            margin-bottom: 0;
        }

        .item-right {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .item-price {
            font-weight: 600;
            color: var(--primary-color);
        }

        .btn-item-action {
            font-size: 0.8rem;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 30px;
            border: none;
        }

        .btn-item-cancel {
            background-color: var(--danger-color);
            color: white;
        }

        .btn-item-cancel:hover {
            background-color: #c0392b;
            color: white;
        }

        .btn-item-return {
            background-color: var(--warning-color);
            color: var(--secondary-color);
        }

        .btn-item-return:hover {
            background-color: #d4ac0d;
            color: var(--secondary-color);
        }

        .summary-card {
            background-color: var(--primary-color);
            color: white;
            border-radius: var(--border-radius);
            padding: 1.5rem;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 0.5rem;
        }

        .summary-total {
            border-top: 2px solid rgba(255, 255, 255, 0.1);
            margin-top: 1rem;
            padding-top: 1rem;
            font-size: 1.25rem;
            font-weight: 600;
        }

        .address-card {
            background: white;
            border-radius: var(--border-radius);
            padding: 1.5rem;
            margin-top: 1.5rem;
            height: 100%;
        }

        .btn-custom {
            padding: 0.75rem 1.5rem;
            border-radius: 50px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn {
            font-size: 0.95rem;
            font-weight: 600;
            padding: 10px 20px;
            border-radius: 30px;
            border: none;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .shop-more-btn {
            background-color: #28a745;
            color: white;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        }

        .shop-more-btn:hover {
            background-color: #218838;
            transform: translateY(-2px);
        }

        .return-request-btn {
            background-color: #ffc107;
            color: #343a40;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        }

        .return-request-btn:hover {
            background-color: #e0a800;
            transform: translateY(-2px);
        }

        .cancel-order-btn {
            background-color: #dc3545;
            color: white;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        }

        .cancel-order-btn:hover {
            background-color: #c82333;
            transform: translateY(-2px);
        }

        .order-card .btn a {
            color: inherit;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <%- include("../../views/partials/user/header") %>

        <div class="header" style="margin-top: 20px;">
            <div class="container">
                <h1 class="mb-0">Order Details</h1>
            </div>
        </div>
        <%- include("../../views/partials/user/sidebar") %>

            <div class="container">
                <% if (order) {
                    // ---- helpers (kept local to the view, no controller change needed) ----
                    const orderStatusLower = (order.status || '').toLowerCase();
                    const badgeClassFor = (status) => {
                        const s = (status || '').toLowerCase().replace(/\s+/g, '-');
                        return `badge-${s}`;
                    };
                    const nonCancellableOrderStatuses = ['delivered', 'cancelled', 'returned', 'return request'];
                    const orderIsCancellable = !nonCancellableOrderStatuses.includes(orderStatusLower);
                    const orderIsDelivered = orderStatusLower === 'delivered';
                    const anyActiveItems = order.orderedItems.some(item => item.status === 'Active');
                %>
                    <div class="order-card">
                        <div class="order-header">
                            <div class="d-flex justify-content-between align-items-start flex-wrap" style="gap: 1rem;">
                                <div>
                                    <span class="order-id">Order #<%= order.orderId %></span>
                                    <p class="text-muted mb-0">Placed on <%= order.createdOn.toDateString() %></p>
                                </div>

                                <div class="badge-pill-group">
                                    <span class="status-badge <%= badgeClassFor(order.status) %>">
                                        Status: <%= order.status.toUpperCase() %>
                                    </span>
                                    <span class="payment-method">
                                        Payment Method: <%= order.paymentMethod.toUpperCase() %>
                                    </span>
                                    <span class="status-badge <%= order.paymentStatus.toLowerCase() === 'completed' ? 'badge-delivered' : 'badge-pending' %>">
                                        Payment Status: <%= order.paymentStatus.toUpperCase() %>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="order-items">
                            <h5 class="mb-4">Order Items</h5>
                            <% order.orderedItems.forEach(item => {
                                const itemStatusLower = (item.status || 'active').toLowerCase();
                                const itemIsActive = itemStatusLower === 'active';
                                const showItemCancel = itemIsActive && orderIsCancellable && !orderIsDelivered;
                                const showItemReturn = itemIsActive && orderIsDelivered;
                            %>
                                <div class="item-card">
                                    <div class="item-details">
                                        <h6 class="mb-1">
                                            <%= item.product ? item.product.productName : item.productName %>
                                        </h6>
                                        <small class="text-muted">Quantity: <%= item.quantity %></small>

                                        <% if (!itemIsActive) { %>
                                            <p class="item-reason">
                                                <% if (itemStatusLower === 'cancelled') { %>
                                                    Reason: <%= item.cancellationReason || 'Not specified' %>
                                                <% } else if (itemStatusLower === 'return request') { %>
                                                    Return reason: <%= item.returnRequestReason || 'Not specified' %> (pending approval)
                                                <% } else if (itemStatusLower === 'returned') { %>
                                                    Item returned<% if (item.returnedOn) { %> on <%= item.returnedOn.toDateString() %><% } %>
                                                <% } %>
                                            </p>
                                        <% } %>
                                    </div>

                                    <div class="item-right">
                                        <span class="status-badge <%= badgeClassFor(item.status || 'Active') %>">
                                            <%= (item.status || 'Active').toUpperCase() %>
                                        </span>
                                        <span class="item-price">₹<%= item.price * item.quantity %></span>

                                        <% if (showItemCancel) { %>
                                            <a href="/cancel-order-item/<%= order._id %>/<%= item._id %>"
                                                class="btn btn-item-action btn-item-cancel">Cancel Item</a>
                                        <% } %>
                                        <% if (showItemReturn) { %>
                                            <a href="/return-order-item/<%= order._id %>/<%= item._id %>"
                                                class="btn btn-item-action btn-item-return">Return Item</a>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="address-card">
                                    <h5 class="mb-3">Delivery Address</h5>
                                    <% if (order.address) { %>
                                        <h6 class="mb-2"><%= order.address.name %></h6>
                                        <p class="mb-1">
                                            <%= order.address.streetName %>, <%= order.address.locality %>
                                        </p>
                                        <p class="mb-1">
                                            <%= order.address.city %>, <%= order.address.state %> - <%= order.address.pin %>
                                        </p>
                                        <p class="mb-0">📞 <%= order.address.contactNo %></p>
                                    <% } %>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="summary-card">
                                    <h5 class="mb-4">Order Summary</h5>
                                    <div class="summary-row">
                                        <span>Subtotal</span>
                                        <span>₹<%= order.totalPrice %></span>
                                    </div>
                                    <% if (order.discount) { %>
                                        <div class="summary-row">
                                            <span>Discount</span>
                                            <span>-₹<%= order.discount %></span>
                                        </div>
                                    <% } %>
                                    <div class="summary-row summary-total">
                                        <span>
                                            <%= order.couponApplied === true ? "Final Amount (discount applied):" : "Final Amount:" %>
                                        </span>
                                        <span>₹<%= order.finalAmount.toLocaleString() %></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 d-flex justify-content-between align-items-center flex-wrap" style="gap: 1rem;">
                            <div class="d-flex flex-wrap" style="gap: 0.75rem;">
                                <% if (orderStatusLower === 'pending') { %>
                                    <a href="/products" class="btn shop-more-btn">Shop More</a>
                                <% } %>

                                <% if (orderIsDelivered && anyActiveItems) { %>
                                    <a href="/return-order-page/<%= order._id %>" class="btn return-request-btn">Return Whole Order</a>
                                <% } else if (orderIsCancellable && anyActiveItems) { %>
                                    <a href="/cancel-order-page/<%= order._id %>" class="btn cancel-order-btn">Cancel Whole Order</a>
                                <% } %>
                            </div>

                            <div class="d-flex flex-wrap" style="gap: 0.75rem;">
                                <% if (order.paymentStatus.toLowerCase() === 'pending' && order.paymentMethod.toLowerCase() === 'razorpay') { %>
                                    <a href="/continue-payment/<%= order._id %>" class="btn btn-primary btn-custom">Continue Payment</a>
                                <% } else if (order.paymentStatus.toLowerCase() !== 'pending' || order.paymentMethod.toLowerCase() === 'cash on delivery') { %>
                                    <a href="/download-invoice/<%= order._id %>" class="btn btn-primary btn-custom">Download Invoice</a>
                                <% } %>
                                <a href="/orders-list" class="btn btn-custom btn-outline-secondary">Back to Orders</a>
                            </div>
                        </div>
                    </div>
                <% } else { %>
                    <div class="alert alert-warning">Order not found.</div>
                <% } %>
            </div>

            <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
            <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</body>

</html>
